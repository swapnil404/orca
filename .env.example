# Server
DATABASE_URL=postgres://orca:local-development@127.0.0.1:55432/orca?sslmode=disable
ORCA_PORT=8080
ORCA_LOG_LEVEL=info
ORCA_JWT_SECRET=replace-with-a-long-random-secret
ORCA_GITHUB_CLIENT_ID=
ORCA_GITHUB_CLIENT_SECRET=
ORCA_GOOGLE_CLIENT_ID=
ORCA_GOOGLE_CLIENT_SECRET=

# TanStack Start server
ORCA_API_URL=http://127.0.0.1:8080

# Agent and server
ORCA_SERVER_URL=ws://localhost:3000/agent

# Agent
ORCA_TOKEN=replace-with-agent-token
ORCA_DATA_DIR=/var/orca/data
ORCA_STATE_PATH=/var/orca/state/desired.json
ORCA_DEV_ADDRESS=127.0.0.1:8081
