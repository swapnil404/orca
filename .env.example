# Server
DATABASE_URL=postgres://orca:change-me@localhost:5432/orca?sslmode=disable
ORCA_PORT=8080
ORCA_LOG_LEVEL=info
ORCA_JWT_SECRET=replace-with-a-long-random-secret
ORCA_GITHUB_CLIENT_ID=
ORCA_GITHUB_CLIENT_SECRET=
ORCA_GOOGLE_CLIENT_ID=
ORCA_GOOGLE_CLIENT_SECRET=

# Agent and server
ORCA_SERVER_URL=ws://localhost:8080/agent

# Agent
ORCA_TOKEN=replace-with-agent-token
ORCA_DATA_DIR=/var/orca/data
ORCA_STATE_PATH=/var/orca/state/desired.json
ORCA_DEV_ADDRESS=127.0.0.1:8080
